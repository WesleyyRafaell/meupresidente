{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meu-presidente-pix",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://fotocompresidente.art,https://www.fotocompresidente.art"
  },
  "secrets": {
    "required": ["MP_ACCESS_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
